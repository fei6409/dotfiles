#!/usr/bin/env bash

set -euo pipefail

info() { printf '\e[1;32mINFO:\e[m %s\n' "$*" >&2; }
if_has() { command -v "$1" > /dev/null 2>&1; }

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ "$BASEDIR" != "$HOME/dotfiles" ]]; then
  printf "Repository must be located at '%s/dotfiles' (current: %s)\n" "$HOME" "$BASEDIR" >&2
  exit 1
fi

cd "$BASEDIR"
info 'Updating git submodules'
git submodule sync --quiet --recursive
git submodule update --init --recursive

platform=$(uname -s)
if [[ "$platform" == Linux ]]; then
  # shellcheck disable=SC1091
  . /etc/os-release
  platform=$ID
fi

info "Detected platform: $platform"

# Ensure ~/.local/bin is in PATH for newly installed mise
export PATH="$HOME/.local/bin:$PATH"

# shellcheck disable=SC2310
if ! if_has mise; then
  case "$platform" in
    Darwin)
      info 'Updating Homebrew'
      brew update
      info 'Installing Mise via Homebrew'
      brew install mise
      ;;
    debian)
      info 'Installing Mise via curl'
      curl https://mise.run | sh
      ;;
    *)
      printf 'Unsupported platform: %s\n' "$platform" >&2
      exit 1
      ;;
  esac
fi

info 'Executing Mise bootstrap'
mise -E "$platform" bootstrap --yes --skip-dirty
